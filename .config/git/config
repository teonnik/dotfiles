# Machine-local identity, LFS and credential helpers. Untracked, so the work
# PC keeps its own email and binary paths.
[include]
  path = ~/.config/git/config.local

[user]
  name = Teodor Nikolov
  # Refuse to commit rather than guessing an email from hostname/username.
  # Forces config.local to exist on a new machine instead of silently
  # authoring under the wrong address.
  useConfigOnly = true

[core]
  editor = nvim
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true    # use n and N to move between diff sections
  light = false

[push]
  default = current
[pull]
  ff = only
[rebase]
  # Stash any dirty changes before rebasing, and restore them afterwards.
  autostash = true
[merge]
  # Like diff3, but drops lines common to both sides out of the conflict
  # region, so the markers wrap only what actually differs.
  conflictstyle = zdiff3

[diff]
  colorMoved = default
