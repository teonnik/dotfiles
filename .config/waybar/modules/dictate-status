#!/bin/bash
# Waybar custom module for the whisper.cpp dictation script (~/bin/dictate).
#
# ~/bin/dictate writes its current state to $XDG_RUNTIME_DIR/dictate/status
# and signals waybar (SIGRTMIN+8) on every transition, so this only needs to
# read the file once per invocation rather than poll.

set -u

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/dictate"
status="$(cat "$STATE_DIR/status" 2>/dev/null || echo idle)"

# Nerd Font (Font Awesome) glyphs. Leading space in the text fields below
# compensates for the glyphs' right-side bearing, which otherwise reads as
# lopsided padding in the waybar cell.
mic=$''          # nf-fa-microphone
mic_slash=$''    # nf-fa-microphone_slash
spinner=$''      # nf-fa-spinner

case "$status" in
    recording)
        printf '{"text":"%s","tooltip":"Dictation: recording…","class":"recording"}\n' "$mic"
        ;;
    transcribing)
        printf '{"text":"%s","tooltip":"Dictation: transcribing…","class":"transcribing"}\n' "$spinner"
        ;;
    *)
        printf '{"text":"%s","tooltip":"Dictation: idle (SUPER+V to record)","class":"idle"}\n' "$mic_slash"
        ;;
esac
