{
    "include": [
        "~/.config/waybar/config-base.jsonc"
    ],
    "modules-right": [
        "idle_inhibitor",
        "battery",
        "backlight",
        "hyprland/language",
        "pulseaudio",
        "tray"
    ],
    "backlight": {
        "format": "{icon} {percent}",
        "format-icons": ""
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    }
}
